# Пароль базы данных (любой длинный)
POSTGRES_PASSWORD=CHANGE_ME
# Подпись cookie сессии: длинная случайная строка
SESSION_SECRET=CHANGE_ME
# Ключ входа в админ-панель /admin
ADMIN_KEY=CHANGE_ME
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Домен сайта без https://. Он должен указывать на IP сервера (A-запись).
# Нет домена? Подойдёт бесплатный адрес с IP: для сервера 203.0.113.7 это 203-0-113-7.sslip.io
DOMAIN=example.com
