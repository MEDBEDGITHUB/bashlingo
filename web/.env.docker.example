# Пароль базы данных (любой длинный)
POSTGRES_PASSWORD=CHANGE_ME
# Подпись cookie сессии: длинная случайная строка
SESSION_SECRET=CHANGE_ME
# Ключ входа в админ-панель /admin
ADMIN_KEY=CHANGE_ME
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Публичный HTTPS-адрес сайта (для кнопки Mini App в боте)
PUBLIC_URL=https://example.com
