# Строка подключения приложения к PostgreSQL
DATABASE_URL=postgres://zurbash:CHANGE_ME@localhost:5433/zurbash
# Суперпользователь: нужен только для npm run db:setup (создаёт роль и базу)
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/postgres
# Секрет для подписи cookie сессии (любая длинная случайная строка)
SESSION_SECRET=CHANGE_ME
# Ключ входа в админ-дашборд /admin
ADMIN_KEY=CHANGE_ME
# Токен бота от @BotFather: нужен для входа через Telegram Mini App
TELEGRAM_BOT_TOKEN=
# Публичный HTTPS-адрес сайта (для кнопки Mini App в боте)
PUBLIC_URL=http://localhost:3000
